# OneNET 物联网平台配置
# 真实值请在 Render 的环境变量中填入，切勿写进本文件或提交到仓库
ONENET_PRODUCT_ID=your_product_id
ONENET_DEVICE_ID=your_device_id
ONENET_TOKEN=your_token

# 服务端口（Render 会自动注入 PORT，本地默认 3001）
PORT=3001

# AI 分析配置 (MiMo)
AI_API_KEY=your_mimo_api_key
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.5-pro

# 代理（本地开发国内访问 MiMo API 需要，Render 不需要）
# HTTPS_PROXY=http://127.0.0.1:7897

# 以下 3 个键当前代码未使用，无需配置
# ONENET_DEVICE_KEY=
# ONENET_ACCESS_KEY=
# ONENET_SECRET_KEY=
